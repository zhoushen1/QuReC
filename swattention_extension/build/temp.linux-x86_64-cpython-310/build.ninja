ninja_required_version = 1.3
cxx = c++
nvcc = /home/stu259129/miniconda3/envs/vim/bin/nvcc

cflags = -pthread -B /home/stu259129/miniconda3/envs/vim/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/stu259129/miniconda3/envs/vim/include -fPIC -O2 -isystem /home/stu259129/miniconda3/envs/vim/include -fPIC -I/home/stu259129/zs_project/swattention_extension/include -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include/TH -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include/THC -I/home/stu259129/miniconda3/envs/vim/include -I/home/stu259129/miniconda3/envs/vim/include/python3.10 -c
post_cflags = -O2 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=swattention -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/stu259129/zs_project/swattention_extension/include -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include/TH -I/home/stu259129/miniconda3/envs/vim/lib/python3.10/site-packages/torch/include/THC -I/home/stu259129/miniconda3/envs/vim/include -I/home/stu259129/miniconda3/envs/vim/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O2 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=swattention -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/stu259129/zs_project/swattention_extension/build/temp.linux-x86_64-cpython-310/av_bw_kernel.o: cuda_compile /home/stu259129/zs_project/swattention_extension/av_bw_kernel.cu
build /home/stu259129/zs_project/swattention_extension/build/temp.linux-x86_64-cpython-310/av_fw_kernel.o: cuda_compile /home/stu259129/zs_project/swattention_extension/av_fw_kernel.cu
build /home/stu259129/zs_project/swattention_extension/build/temp.linux-x86_64-cpython-310/qk_bw_kernel.o: cuda_compile /home/stu259129/zs_project/swattention_extension/qk_bw_kernel.cu
build /home/stu259129/zs_project/swattention_extension/build/temp.linux-x86_64-cpython-310/qk_fw_kernel.o: cuda_compile /home/stu259129/zs_project/swattention_extension/qk_fw_kernel.cu
build /home/stu259129/zs_project/swattention_extension/build/temp.linux-x86_64-cpython-310/qk_rpb_bw_kernel.o: cuda_compile /home/stu259129/zs_project/swattention_extension/qk_rpb_bw_kernel.cu
build /home/stu259129/zs_project/swattention_extension/build/temp.linux-x86_64-cpython-310/qk_rpb_fw_kernel.o: cuda_compile /home/stu259129/zs_project/swattention_extension/qk_rpb_fw_kernel.cu
